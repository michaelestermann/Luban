// Luban 4.17 tabs: project panel with the machine section (design D, 232px / collapsed 48px)

.panel {
    width: 232px;
    height: calc(100vh - 40px);
    position: sticky;
    top: 0;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #f8f9fb;
    border-right: 1px solid #e3e6ec;
    box-sizing: border-box;
    font-size: 12.5px;
    color: #1f2430;
    user-select: none;
    z-index: 20;
}

.panel.collapsed {
    width: 48px;
    align-items: center;
    gap: 2px;
    padding-top: 8px;
}

.header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 8px 4px 6px;
}

.label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5b6170;
    white-space: nowrap;
}

.spacer {
    flex: 1 1 auto;
}

.icon-button {
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2f3441;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    padding: 0;
    position: relative;

    &:hover {
        background: #eef1f6;
    }
}

.collapsed .icon-button {
    width: 34px;
    height: 34px;
}

.list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0 6px;
    overflow-y: auto;
    min-height: 0;
    flex: 0 1 auto;
}

.group {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.group-label {
    padding: 10px 8px 4px;
    display: flex;
    gap: 6px;
    align-items: center;
}

.count {
    color: #9aa1b0;
}

.row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px 5px 8px;
    border-radius: 8px;
    min-height: 40px;
    box-sizing: border-box;

    &:hover {
        background: #eef1f6;
    }

    &:hover .row-actions {
        opacity: 1;
    }
}

.row.active {
    background: #dbe6fd;

    .row-actions {
        opacity: 1;
    }

    .row-name {
        font-weight: 600;
    }
}

.row-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    flex: 1 1 auto;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
    outline: none;
}

.row-name {
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.row-status {
    font-size: 11px;
    color: #5b6170;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.unsaved-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: #1f2430;
    flex: 0 0 auto;
    display: block;
}

.row:hover .unsaved-dot {
    display: none;
}

.row-actions {
    display: flex;
    gap: 2px;
    opacity: 0;
    flex: 0 0 auto;
}

.row-actions:focus-within {
    opacity: 1;
}

.small-icon-button {
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #5b6170;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;

    &:hover {
        background: #dfe4ec;
        color: #1f2430;
    }
}

.empty {
    padding: 14px 8px;
    color: #5b6170;
    font-size: 12px;
    line-height: 1.5;
    white-space: normal;
}

.actions {
    display: flex;
    gap: 6px;
    padding: 10px 8px;
    position: relative;
    flex: 0 0 auto;
}

.small-button {
    height: 28px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #fff;
    font-size: 12px;
    font-weight: 600;
    color: #2f3441;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    white-space: nowrap;

    &:hover {
        background: #f3f5f8;
    }
}

.actions .small-button {
    flex: 1 1 0;
}

.small-button.pressed {
    background: #e8eefc;
    border-color: #b7c7f3;
}

.small-primary {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #fff;

    &:hover {
        background: #1e40af;
    }
}

.popover {
    position: absolute;
    left: 8px;
    bottom: 44px;
    width: 300px;
    max-height: 360px;
    overflow-y: auto;
    padding: 6px;
    background: #fff;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(20, 30, 50, .18);
    z-index: 40;
}

.popover-row {
    width: 100%;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;

    &:hover {
        background: #f3f5f8;
    }

    .row-name {
        flex: 1 1 auto;
        min-width: 0;
    }
}

.tag {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: 9px;
    background: #e8eefc;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 600;
}

// collapsed panel: one icon per project, separators per mode
.mini-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    overflow-y: auto;
    min-height: 0;
    flex: 0 1 auto;
}

.mini-separator {
    width: 20px;
    height: 1px;
    background: #e3e6ec;
    margin: 3px 0;
    display: block;
    flex: 0 0 auto;
}

.mini-row {
    position: relative;
    width: 36px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    flex: 0 0 auto;

    &:hover {
        background: #eef1f6;
    }
}

.mini-row.active {
    background: #dbe6fd;
}

.mini-dot {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: #1f2430;
}

.mini-machine {
    margin-bottom: 10px;
    color: #15803d;
}

.mini-conn {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border: 2px solid #f8f9fb;
    background: #9aa1b0;
}

.mini-conn.connected {
    background: #16a34a;
}

// machine section, pinned at the bottom of the panel
.machine {
    border-top: 1px solid #e3e6ec;
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #fff;
    flex: 0 0 auto;
}

.machine-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

.machine-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #f0fdf4;
    color: #15803d;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}

.machine-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.machine-name {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.machine-toolhead {
    font-size: 11.5px;
    color: #5b6170;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.machine-conn {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
}

.conn-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: #9aa1b0;
    display: block;
    flex: 0 0 auto;
}

.conn-dot.connected {
    background: #16a34a;
}

// "Machine switched to ..." notice (top, centered)
.notice {
    position: fixed;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1100;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #fff7ed;
    border: 1px solid #fdba74;
    color: #7c2d12;
    font-size: 13px;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(20, 30, 50, .22);
}

.notice-action {
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
}

.notice-dismiss {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    display: flex;
    padding: 2px;
}

// a project made for another machine: bar above its page
.mismatch-bar {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    background: #fff7ed;
    border-bottom: 1px solid #fed7aa;
    color: #9a3412;
    font-size: 12.5px;
    flex: 0 0 auto;
    box-sizing: border-box;
    min-width: 0;
}

.mismatch-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.mismatch-action {
    height: 26px;
    padding: 0 10px;
    border: 1px solid #fdba74;
    border-radius: 6px;
    background: #fff;
    color: #9a3412;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;

    &:hover {
        background: #ffedd5;
    }
}
