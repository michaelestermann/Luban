// Luban 4.17 tabs: tab strip (design D, 40px)

.tab-shell {
    display: flex;
    flex-direction: column;
}

.tab-strip {
    height: 40px;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 0 8px;
    background: #e6eaf0;
    border-bottom: 1px solid #e3e6ec;
    flex: 0 0 auto;
    box-sizing: border-box;
    position: relative;
    z-index: 30;
    user-select: none;
}

.tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 6px 0 10px;
    border-radius: 8px 8px 0 0;
    font-size: 12.5px;
    font-weight: 500;
    color: #2f3441;
    background: transparent;
    flex: 0 1 190px;
    min-width: 0;
    box-sizing: border-box;
    cursor: pointer;

    &:hover {
        background: #f3f5f8;
    }

    .name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
        flex: 1;
        text-align: left;
        border: 0;
        background: transparent;
        padding: 0;
        font: inherit;
        color: inherit;
        cursor: pointer;
        outline: none;
    }

    .icon {
        display: inline-flex;
        flex: 0 0 auto;
    }

    // the dot sits in the slot of the close button (no layout shift when one replaces the other)
    .unsaved-dot {
        position: absolute;
        right: 12px;
        top: 50%;
        margin-top: -4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #1f2430;
        display: block;
        pointer-events: none;
    }

    // always takes its 20px, shown on hover / for the active tab (hidden keeps the tab width steady)
    .close {
        width: 20px;
        height: 20px;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: #5b6170;
        display: flex;
        visibility: hidden;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex: 0 0 auto;
        padding: 0;

        &:hover {
            background: #dfe4ec;
            color: #1f2430;
        }
    }

    &:hover .close {
        visibility: visible;
    }

    &:hover .unsaved-dot {
        visibility: hidden;
    }
}

.tab.active {
    background: #fff;
    color: #1f2430;
    box-shadow: 0 -1px 0 #e3e6ec inset;

    .close {
        visibility: visible;
    }

    &.dirty .close {
        visibility: hidden;
    }

    &.dirty:hover .close {
        visibility: visible;
    }
}

.tab.load-failed .name {
    color: #c75b00;
    font-style: italic;
}

.tab.home {
    flex: 0 0 40px;
    justify-content: center;
    padding: 0;

    .name {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1d4ed8;
        flex: 0 0 auto;
    }
}

.tab.workspace {
    flex: 0 0 auto;
    padding-right: 12px;

    .name {
        font-weight: 600;
    }
}

.conn-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: #9aa1b0;
    display: block;
    flex: 0 0 auto;
}

.conn-dot.connected {
    background: #16a34a;
}

.badge {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 7px;
    border-radius: 9px;
    background: #dcfce7;
    color: #15803d;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
}

.separator {
    width: 1px;
    height: 16px;
    background: #cfd5df;
    flex: 0 0 auto;
    margin: 0 6px 10px;
}

.doc-tabs {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
}

// overflow (design D): the tabs shrink to 120px, then the row scrolls with the arrow buttons
.doc-scroll {
    flex: 0 1 auto;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}

.tab.doc-tab {
    flex: 0 1 190px;
    min-width: 120px;
}

.scroll-button {
    width: 24px;
    height: 28px;
    margin-bottom: 2px;

    &:disabled {
        opacity: .35;
        cursor: default;
        background: transparent;
    }
}

.icon-button-open {
    background: #f3f5f8;
}

// all open projects, grouped by mode, with search
.all-tabs {
    position: absolute;
    right: 8px;
    top: 44px;
    width: 300px;
    max-height: calc(100vh - 80px);
    padding: 8px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #e3e6ec;
    box-shadow: 0 12px 30px rgba(20, 30, 50, .18);
    display: flex;
    flex-direction: column;
    gap: 4px;
    box-sizing: border-box;
    z-index: 40;
    font-size: 13px;
    color: #1f2430;
}

.all-tabs-search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 8px;
    color: #9aa1b0;
    margin-bottom: 4px;
    flex: 0 0 auto;

    input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: none;
        background: transparent;
        font: inherit;
        color: #1f2430;
    }

    &:focus-within {
        border-color: #1d4ed8;
    }
}

.all-tabs-list {
    overflow-y: auto;
    min-height: 0;
}

.all-tabs-label {
    padding: 6px 10px 2px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #5b6170;
}

.all-tabs-row {
    width: 100%;
    height: 28px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;

    &:hover {
        background: #f3f5f8;
    }

    &.selected {
        background: #e8eefc;
    }

    .unsaved-dot {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #1f2430;
        margin-left: auto;
        flex: 0 0 auto;
    }
}

.all-tabs-name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.all-tabs-empty {
    padding: 8px 10px;
    color: #9aa1b0;
}

.icon-button {
    width: 30px;
    height: 30px;
    margin-bottom: 1px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2f3441;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    padding: 0;

    &:hover {
        background: #f3f5f8;
    }
}

// project panel (left) | page (design D)
.tab-body {
    flex: 1 1 auto;
    display: flex;
    align-items: flex-start;
    min-height: 0;
}

.tab-page {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    position: relative;
}

.tab-content {
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
}

// dialogs of the tab shell: "+" mode chooser, save prompt, quit list (design D)

.backdrop {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(20, 30, 50, .35);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1100;
    font-size: 13px;
    color: #1f2430;
}

.backdrop-top {
    align-items: flex-start;
    padding-top: 90px;
}

.dialog {
    width: 440px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 120px);
    padding: 20px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 20px 50px rgba(20, 30, 50, .25);
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
    outline: none;
}

.chooser {
    width: 600px;
    gap: 14px;
}

.chooser-wide {
    width: 900px;
    // one height for all pages (no jump when another item is chosen); the page scrolls inside
    height: calc(100vh - var(--tab-strip-height, 40px) - 40px);
    max-height: 800px;
    padding: 18px 20px;
    gap: 12px;
}

// step 2 sits right below the tab strip: the Job Setup form needs the height (1024 x 708)
.backdrop-np {
    align-items: flex-start;
    padding-top: calc(var(--tab-strip-height, 40px) + 12px);
}

.quit-dialog {
    width: 520px;
}

.dialog-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.dialog-head-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.dialog-title {
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: normal;
}

.dialog-text {
    color: #5b6170;
    font-size: 12.5px;
    line-height: 1.5;
    white-space: normal;
}

.muted {
    color: #5b6170;
    font-size: 12.5px;
    white-space: normal;
}

.push-right {
    margin-left: auto;
}

.spacer {
    flex: 1;
}

.dialog-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 4px;
}

.primary,
.secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
}

.primary {
    border: 1px solid #1d4ed8;
    background: #1d4ed8;
    color: #fff;

    &:hover {
        background: #1e40af;
    }
}

.secondary {
    border: 1px solid #d9dde6;
    background: #fff;
    color: #1f2430;

    &:hover {
        background: #f3f5f8;
    }
}

.primary:focus-visible,
.secondary:focus-visible,
.mode-card:focus-visible,
.row:focus-visible,
.np-nav-item:focus-visible,
.case-card:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
}

.mode-cards {
    display: flex;
    gap: 12px;
}

.mode-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border: 1px solid #e3e6ec;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;

    b {
        font-size: 14px;
    }

    &:hover {
        border-color: #1d4ed8;
        background: #f8faff;
    }
}

.mode-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.label {
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #5b6170;
}

.empty {
    padding: 8px 10px;
    color: #8a90a0;
}

.row {
    width: 100%;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    box-sizing: border-box;

    &:hover {
        background: #f3f5f8;
    }
}

.row-name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 0 0 auto;
    max-width: 60%;
}

.row-path {
    margin-left: auto;
    color: #8a90a0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 0;
    min-width: 0;
    direction: rtl;
    text-align: right;
}

.tag {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: 9px;
    background: #e8eefc;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 600;
}

.quit-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 12px;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    max-height: 320px;
    overflow-y: auto;
}

.quit-item {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;

    input {
        margin: 0;
        cursor: pointer;
    }
}

// step 2 of the new project dialog: items on the left, the page of the selected one on the right

.np-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 16px;
    min-height: 0;
    flex: 1 1 auto;
}

.np-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-right: 16px;
    border-right: 1px solid #e3e6ec;
}

.np-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    color: #1f2430;
    text-align: left;
    cursor: pointer;

    svg {
        flex: 0 0 auto;
        color: #5b6170;
    }

    &:hover {
        background: #f3f5f8;
    }
}

.np-nav-item.selected {
    background: #e8eefc;
    color: #1d4ed8;
    font-weight: 600;

    svg {
        color: #1d4ed8;
    }
}

.np-nav-label {
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    line-height: 1.3;
}

.np-count {
    flex: 0 0 auto;
    min-width: 20px;
    padding: 0 6px;
    border-radius: 9px;
    background: #eef0f4;
    color: #5b6170;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
}

.np-content {
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
    padding-right: 4px;
}

.np-page {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 100%;
}

.np-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.np-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    font-weight: normal;
}

.np-section {
    font-weight: 600;
}

.np-input {
    width: 100%;
    max-width: 420px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid #c8cdd6;
    border-radius: 6px;
    font: inherit;
    color: #1f2430;
    outline: none;
    box-sizing: border-box;

    &:focus {
        border-color: #1d4ed8;
        box-shadow: 0 0 0 2px rgba(29, 78, 216, .15);
    }
}

.np-hint {
    color: #8a90a0;
    font-size: 12px;
    white-space: normal;
}

.np-job-setup {
    padding-top: 12px;
    border-top: 1px solid #eef0f4;
}

.np-note {
    color: #5b6170;
    line-height: 1.5;
    white-space: normal;
}

.np-drop {
    flex: 1 1 auto;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    border: 2px dashed #c8cdd6;
    border-radius: 12px;
    color: #5b6170;
    text-align: center;

    b {
        color: #1f2430;
        font-size: 14px;
    }

    .primary {
        margin-top: 8px;
    }
}

.np-drop-over {
    border-color: #1d4ed8;
    background: #f8faff;
}

.np-error {
    color: #c2410c;
}

.case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
}

.case-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    background: #fff;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;

    &:hover {
        border-color: #1d4ed8;
        background: #f8faff;
    }
}

.case-card-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    object-fit: cover;
    background: #f3f5f8;
}

.case-card-title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.case-card-tag {
    color: #8a90a0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

// progress modal of a running task: below the strip (see ProgressBar)
:global(.below-tab-strip) {
    top: var(--tab-strip-height, 0px) !important;
}
