// Luban 4.17 tabs: tab strip (design D, 40px)

.tab-shell {
    display: flex;
    flex-direction: column;
}

.tab-strip {
    height: 40px;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    padding: 0 8px;
    background: #e6eaf0;
    border-bottom: 1px solid #e3e6ec;
    flex: 0 0 auto;
    box-sizing: border-box;
    position: relative;
    z-index: 30;
    user-select: none;
}

.tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 6px 0 10px;
    border-radius: 8px 8px 0 0;
    font-size: 12.5px;
    font-weight: 500;
    color: #2f3441;
    background: transparent;
    flex: 0 1 190px;
    min-width: 0;
    box-sizing: border-box;
    cursor: pointer;

    &:hover {
        background: #f3f5f8;
    }

    .name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
        flex: 1;
        text-align: left;
        border: 0;
        background: transparent;
        padding: 0;
        font: inherit;
        color: inherit;
        cursor: pointer;
        outline: none;
    }

    .icon {
        display: inline-flex;
        flex: 0 0 auto;
    }

    .unsaved-dot {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #1f2430;
        flex: 0 0 auto;
        display: block;
    }

    .close {
        width: 20px;
        height: 20px;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: #5b6170;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex: 0 0 auto;
        padding: 0;

        &:hover {
            background: #dfe4ec;
            color: #1f2430;
        }
    }

    &:hover .close {
        display: flex;
    }

    &:hover .unsaved-dot {
        display: none;
    }
}

.tab.active {
    background: #fff;
    color: #1f2430;
    box-shadow: 0 -1px 0 #e3e6ec inset;

    .close {
        display: flex;
    }

    &.dirty .close {
        display: none;
    }

    &.dirty:hover .close {
        display: flex;
    }
}

.tab.home {
    flex: 0 0 40px;
    justify-content: center;
    padding: 0;

    .name {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1d4ed8;
        flex: 0 0 auto;
    }
}

.tab.workspace {
    flex: 0 0 auto;
    padding-right: 12px;

    .name {
        font-weight: 600;
    }
}

.conn-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: #9aa1b0;
    display: block;
    flex: 0 0 auto;
}

.conn-dot.connected {
    background: #16a34a;
}

.badge {
    display: inline-flex;
    align-items: center;
    height: 18px;
    padding: 0 7px;
    border-radius: 9px;
    background: #dcfce7;
    color: #15803d;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
}

.separator {
    width: 1px;
    height: 16px;
    background: #cfd5df;
    flex: 0 0 auto;
    margin: 0 6px 10px;
}

.doc-tabs {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
}

.icon-button {
    width: 30px;
    height: 30px;
    margin-bottom: 1px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2f3441;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
    padding: 0;

    &:hover {
        background: #f3f5f8;
    }
}

.tab-content {
    flex: 1 1 auto;
    min-height: 0;
}

// dialogs of the tab shell: "+" mode chooser, save prompt, quit list (design D)

.backdrop {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(20, 30, 50, .35);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1100;
    font-size: 13px;
    color: #1f2430;
}

.backdrop-top {
    align-items: flex-start;
    padding-top: 90px;
}

.dialog {
    width: 440px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 120px);
    padding: 20px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 20px 50px rgba(20, 30, 50, .25);
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
    outline: none;
}

.chooser {
    width: 600px;
    gap: 14px;
}

.chooser-wide {
    width: 640px;
    gap: 14px;
}

.quit-dialog {
    width: 520px;
}

.dialog-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.dialog-head-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.dialog-title {
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: normal;
}

.dialog-text {
    color: #5b6170;
    font-size: 12.5px;
    line-height: 1.5;
    white-space: normal;
}

.muted {
    color: #5b6170;
    font-size: 12.5px;
    white-space: normal;
}

.push-right {
    margin-left: auto;
}

.spacer {
    flex: 1;
}

.dialog-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 4px;
}

.primary,
.secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
}

.primary {
    border: 1px solid #1d4ed8;
    background: #1d4ed8;
    color: #fff;

    &:hover {
        background: #1e40af;
    }
}

.secondary {
    border: 1px solid #d9dde6;
    background: #fff;
    color: #1f2430;

    &:hover {
        background: #f3f5f8;
    }
}

.secondary.pressed {
    background: #e8eefc;
    border-color: #1d4ed8;
}

.primary:focus-visible,
.secondary:focus-visible,
.mode-card:focus-visible,
.row:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
}

.mode-cards {
    display: flex;
    gap: 12px;
}

.mode-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border: 1px solid #e3e6ec;
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;

    b {
        font-size: 14px;
    }

    &:hover {
        border-color: #1d4ed8;
        background: #f8faff;
    }
}

.mode-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chooser-body {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    min-height: 0;
}

.chooser-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;

    .primary,
    .secondary {
        height: 44px;
        justify-content: flex-start;
    }
}

.chooser-list {
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    padding: 6px;
    max-height: 340px;
    overflow-y: auto;
    min-width: 0;
}

.label {
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #5b6170;
}

.empty {
    padding: 8px 10px;
    color: #8a90a0;
}

.row {
    width: 100%;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
    box-sizing: border-box;

    &:hover {
        background: #f3f5f8;
    }
}

.row-name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 0 0 auto;
    max-width: 60%;
}

.row-path {
    margin-left: auto;
    color: #8a90a0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 0;
    min-width: 0;
    direction: rtl;
    text-align: right;
}

.tag {
    flex: 0 0 auto;
    padding: 1px 7px;
    border-radius: 9px;
    background: #e8eefc;
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 600;
}

.case-img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    object-fit: cover;
    flex: 0 0 auto;
}

.quit-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 12px;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    max-height: 320px;
    overflow-y: auto;
}

.quit-item {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;

    input {
        margin: 0;
        cursor: pointer;
    }
}
