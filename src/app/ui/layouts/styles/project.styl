@import "../../../styles/variables.styl"
// TODO: refactor;
@import "../../widgets/styles.styl"

[class~='appbar'] {
    .content-flex {
        height: calc(100vh - 90px);
    }
}

.project-layout {
    .main-toolbar {
        width: 100%;
        border-top: 1px solid #f2f2f5;
        border-bottom: 1px solid #f2f2f5;
        background-color: #FFFFFF;
    }

    :global(.ant-spin.ant-spin-spinning) {
        max-height: none;
        height: calc(100vh - 70px)
    }

    .content-flex {
        display: flex;
        height: calc(100vh - 70px);
        overflow: hidden;
        background-color: #F5F5F7; // use the same color as scene background

        .visualizer {
            flex: 1;
            order: 0;
            overflow: hidden;
        }
    }

    .long-lang-content-height {
        height: calc(100vh - 74px);
    }

    .configuration-panel {
        flex: 0 0 auto;
        overflow: auto;
        margin: 8px 8px 8px 0;
        // background-color: #FFFFFF;
        order: 1;
    }
}

// Laser/CNC editor: compact toolbar row (52px), left panel | canvas | right panel
[class~='appbar'] {
    .project-layout.with-panels .content-flex {
        height: calc(100vh - 79px);
    }
}

.project-layout.with-panels {
    .main-toolbar {
        border-top: 0;
        border-bottom: 1px solid #e3e6ec;
    }

    :global(.ant-spin.ant-spin-spinning) {
        height: calc(100vh - 54px)
    }

    .content-flex {
        height: calc(100vh - 54px);
        background-color: #eef1f5;
        position: relative;
    }

    .left-panel {
        flex: 0 0 auto;
        order: -1;
        height: 100%;
        overflow: hidden;
    }

    .right-panel {
        flex: 0 0 auto;
        order: 1;
        height: 100%;
        position: relative;
        z-index: 20;
    }
}
