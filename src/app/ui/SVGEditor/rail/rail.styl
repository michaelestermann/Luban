// Left tool rail: separator, Measure tool and helper switches (mockup "Concept · where controls live")
.separator {
    width: 28px;
    height: 1px;
    margin: 4px auto;
    background: #e3e6ec;
}

.rail-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #545659;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eeeff0;
    }

    &.on,
    &.on:hover:not(:disabled) {
        background: #b9ddff;
        color: #1890ff;
    }

    &:disabled {
        cursor: not-allowed;
        opacity: .4;
    }
}

// switch with options: small triangle in the lower right corner
.corner {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 0;
    height: 0;
    border-left: 5px solid transparent;
    border-bottom: 5px solid currentColor;
    opacity: .6;
}

// options popover of a switch (mockup "Dimensions · options")
.options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 226px;
    font-size: 13px;
    color: #1f2430;
}

.options-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5b6170;
}

.segments {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background: #eef1f6;
}

.segment {
    flex: 1;
    height: 28px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font-size: 12px;
    font-weight: 600;
    color: #5b6170;
    cursor: pointer;

    &.on {
        background: #ffffff;
        color: #1d4ed8;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .08);
    }
}

.check {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-weight: 400;
    cursor: pointer;
}

.note {
    font-size: 12px;
    color: #5b6170;
}

// Snap options: Grid checkbox with the grid size beside it
.check-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.grid-size {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #5b6170;

    input {
        width: 56px;
        height: 24px;
        padding: 0 4px;
        border: 1px solid #d5d9e0;
        border-radius: 4px;
        font-size: 12px;
        color: #1f2430;
    }

    input:disabled {
        background: #f3f4f6;
        color: #9aa0ab;
    }
}
