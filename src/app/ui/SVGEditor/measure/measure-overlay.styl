// Measure tool and dimension chains drawn over the canvas (mockups "Measure", "Dimension chains")
.overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    overflow: hidden;
}

.graphics {
    position: absolute;
    top: 0;
    left: 0;
    font-family: inherit;
}
