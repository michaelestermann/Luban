// Point card of the point editing mode (mockup "Points B · popover at the point")
.overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
    overflow: hidden;
}

.card {
    position: absolute;
    z-index: 16;
    width: 232px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    background: #ffffff;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(20, 30, 50, .12);
    pointer-events: auto;
}

.header {
    display: flex;
    align-items: center;
    gap: 8px;
}

.title {
    font-size: 13px;
    font-weight: 600;
    color: #1f2430;
}

.hint {
    flex: 1 1 auto;
    font-size: 12px;
    color: #9aa1b0;
}

.close {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #5b6170;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    &:hover {
        background: #eef1f6;
    }
}

.grid2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

// same field as the properties panel
.field {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #ffffff;
    font-size: 13px;
    color: #1f2430;
    min-width: 0;

    &:focus-within {
        border-color: #1d4ed8;
    }

    > span:last-child {
        flex: 1 1 auto;
        min-width: 0;
    }

    :global(.ant-input-affix-wrapper),
    :global(.ant-input) {
        width: 100% !important;
        height: 30px;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        font-size: 13px;
        color: inherit;
    }

    :global(.ant-input-suffix) {
        font-size: 12px;
        color: #5b6170;
    }
}

.prefix {
    flex: 0 0 auto;
    color: #5b6170;
}

.type-button,
.action-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #ffffff;
    color: #2f3441;
    font-size: 13px;
    white-space: nowrap;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &:disabled {
        cursor: not-allowed;
        border-color: #e3e6ec;
        background: #f0f2f5;
        color: #b8bfcc;
    }
}

.type-button.on {
    border-color: #1d4ed8;
    background: #e8eefc;
    color: #1d4ed8;
}

.actions {
    display: flex;
    gap: 8px;

    .action-button:first-child {
        flex: 1 1 auto;
    }
}

.action-button.danger {
    width: 40px;
    padding: 0;
    color: #dc2626;

    &:hover:not(:disabled) {
        background: #fdecec;
    }
}
