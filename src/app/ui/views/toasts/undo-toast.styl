.undo-toast {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    line-height: 18px;
}

.undo-button {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    color: #1d4ed8;
    font-weight: 600;
    cursor: pointer;

    &:hover {
        text-decoration: underline;
    }
}
