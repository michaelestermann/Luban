// Settings of the selected toolpath in the step-2 right panel (redesign mockup StepToolpaths)
.fast-configurations {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 16px 0;
}

.section {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5b6170;
}

// parameters section: the selector and parameter rows lay themselves out, "More >" floats right
.parameters {
    display: block;

    .label {
        margin-bottom: 8px;
    }
}
