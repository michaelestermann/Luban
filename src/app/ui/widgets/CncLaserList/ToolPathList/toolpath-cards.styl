// Step-2 toolpath list as cards and the toolpath settings panel (redesign mockup StepToolpaths)
.toolpath-list {
    display: flex;
    flex-direction: column;
}

.cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 48px;
    padding: 0 10px 8px;
    outline: none;
}

.empty {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    padding: 8px 4px;
    font-size: 12px;
    color: #5b6170;
}

.card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    background: #f8f9fb;
    cursor: pointer;
    outline: none;
    user-select: none;

    &:hover {
        border-color: #b8c5e8;
    }

    &:focus-visible {
        box-shadow: 0 0 0 2px #1d4ed8;
    }

    &.selected {
        border-color: #1d4ed8;
        background: #eef3ff;
    }

    &.hidden .card-title,
    &.hidden .card-sub {
        color: #9aa1b0;
    }
}

.card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.dot {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 5px;
}

.card-title {
    flex: 1 1 auto;
    min-width: 48px;
    font-size: 13px;
    font-weight: 600;
    color: #1f2430;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.status {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 50%;
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.status-ok {
    display: inline-flex;
    color: #15803d;
}

.status-needs-preview {
    color: #b45309;
}

.status-generating {
    color: #5b6170;
}

.status-failed {
    color: #b91c1c;
}

.eye {
    flex: 0 0 auto;
    display: inline-flex;
    height: 24px;
}

.card-sub {
    padding-left: 18px;
    font-size: 12px;
    color: #5b6170;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.actions {
    display: flex;
    align-items: center;
    padding: 0 10px;
}

.actions-spacer {
    flex: 1 1 auto;
}

.create-row {
    padding: 8px 10px 12px;
}

.create-button {
    width: 100%;
    height: 34px;
    border: 1px dashed #b8bfcc;
    border-radius: 8px;
    background: #ffffff;
    font-size: 13px;
    font-weight: 600;
    color: #2f3441;
    cursor: pointer;

    &:hover:not(:disabled) {
        border-color: #1d4ed8;
        color: #1d4ed8;
    }

    &:disabled {
        color: #9aa1b0;
        cursor: not-allowed;
    }
}

// right panel (ToolPathSettings)
.settings {
    display: flex;
    flex-direction: column;
}

.hint {
    padding: 4px 16px 12px;
    font-size: 12px;
    color: #5b6170;
}
