@import '../../../styles/global-var.styl';

.object-list-box {
    max-height: 176px;
    overflow-y: auto;
    //margin: 4px 0;
    //padding-top: 4px;
}

.object-list-fill {
    width: 100%;
}

.object-list-item {
    padding: 4px 0;

    &.selected {
        background-color: $background-color-selected;
    }

    &:not(.selected):hover {
        background-color: #EEEFF0;
    }

    .process {
        padding: 0 12px;
    }

    .prefix-name {
        display: inline-block
        vertical-align: middle
        max-width: 85%;
        overflow: hidden
        white-space: nowrap
        text-overflow: ellipsis
    }

    .suffix-name {
        display: inline-block
        vertical-align: middle
    }

    .icon {
        box-sizing: content-box;
        display: inline-block;
        width: 24px;
        height: 24px;
        vertical-align: middle;
        margin: 0 4px;
    }

    .icon-shape {
        background: url("images/list_ic_shape_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-pic {
        background: url("images/list_ic_pic_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-text {
        background: url("images/list_ic_text_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-check {
        background: url("images/ic_box_check_14x14.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-uncheck {
        background: url("images/ic_box_uncheck_14x14.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-running {
        background: url("images/list_ic_running_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-warning {
        background: url("images/list_ic_warning_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-error {
        background: url("images/list_ic_error_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }
}

// toolpath membership dots in an object row (operation colours)
.operation-dots {
    display: flex;
    align-items: center;
    gap: 3px;
    margin: 0 6px;
    flex: 0 0 auto;
}

.operation-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

// groups in the object list (one level): foldable row, members under a guide line
.group-row {
    display: flex;
    align-items: center;
    font-weight: 600;
}

.group-caret {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 24px;
    margin-left: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: #5b6170;
    cursor: pointer;
}

.group-name {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
}

.group-icon {
    display: flex;
    color: #7c3aed;
}

.group-label {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.group-count {
    flex: 0 0 auto;
    padding: 0 6px;
    border-radius: 8px;
    background: #ede9fe;
    color: #6d28d9;
    font-size: 11px;
    line-height: 16px;
}

.group-members {
    margin-left: 20px;
    padding-left: 4px;
    border-left: 2px solid #e3e6ec;
}

.in-selected-group {
    background: #eef3fe;
}

// object list drag and drop (layer order): the whole row is dragged, no grip
.layer-row {
    cursor: grab;
}

.layer-dragging {
    opacity: .45;
}

.layer-drop-before {
    box-shadow: inset 0 3px 0 #1d4ed8;
}

.layer-drop-after {
    box-shadow: inset 0 -3px 0 #1d4ed8;
}

// inline rename in the object list
.name-input {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    height: 22px;
    margin: 0 4px 0 0;
    padding: 0 4px;
    border: 1px solid #1d4ed8;
    border-radius: 4px;
    outline: none;
    font: inherit;
    color: inherit;
    background: #fff;
    cursor: text;
    box-shadow: 0 0 0 2px rgba(29, 78, 216, .15);
}
