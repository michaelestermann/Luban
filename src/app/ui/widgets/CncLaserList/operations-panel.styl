// Step-1 Operations panel (colours and sizes from the redesign mockup InteractionA)
.operations-panel {
    border-top: 1px solid #e3e6ec;
    margin-top: 6px;
}

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 14px 6px;
}

.label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5b6170;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tip-wrapper {
    display: inline-flex;
}

.new-button {
    flex: 0 0 auto;
    height: 26px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #ffffff;
    font-size: 12px;
    font-weight: 600;
    color: #1f2430;
    cursor: pointer;
    white-space: nowrap;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &:disabled {
        color: #9aa1b0;
        cursor: not-allowed;
        pointer-events: none;
    }
}

.cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px 12px;
}

.empty {
    padding: 8px 4px;
    font-size: 12px;
    color: #5b6170;
}

.card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    background: #f8f9fb;
}

.card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.dot {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 5px;
}

.card-title {
    // The operation name wins over the tool text (mockup: name left, tool right)
    flex: 0 1 auto;
    min-width: 0;
    max-width: 70%;
    font-size: 13px;
    font-weight: 600;
    color: #1f2430;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.card-tool {
    flex: 1 1 0;
    min-width: 0;
    text-align: right;
    font-size: 12px;
    color: #5b6170;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.chip {
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    height: 24px;
    padding: 0 4px 0 9px;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid #d9dde6;
    font-size: 12px;
    color: #1f2430;
}

.chip-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
}

.chip-remove {
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #5b6170;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eef1f6;
        color: #1f2430;
    }

    &:disabled {
        color: #c4c8d1;
        cursor: not-allowed;
        pointer-events: none;
    }
}

.add-button {
    height: 24px;
    padding: 0 9px;
    border: 1px dashed #1d4ed8;
    border-radius: 12px;
    background: transparent;
    font-size: 12px;
    font-weight: 500;
    color: #1d4ed8;
    cursor: pointer;
    white-space: nowrap;

    &:hover:not(:disabled) {
        background: #e8eefc;
    }

    &:disabled {
        border-color: #d9dde6;
        color: #9aa1b0;
        cursor: default;
        pointer-events: none;
    }
}
