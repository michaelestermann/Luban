@import "../styles.styl"

$z-index-float = 500

.visualizer-top-right {
    top: 35%
    z-index: $z-index-float
    text-align: left
}

.top-right-div11 {
    background: url("/resources/images/18x18/ic_back_normal_18x18.png") no-repeat center / 18px 18px
    width: 18px
    height: 18px
    display: inline-block
    margin-top: 5px
}

.top-right-div12 {
    height: 18px
    display: inline-block
    vertical-align: middle
    margin-top: -10px
}

.top-right-div2 {
    margin-top: 64px
    margin-left: 50px
    height: 104px
    width: 134px
    background: #FFFFFF
    border-radius: 4px
    border: 1px solid #C8C8C8

    .title {
        margin-top: 16px
        margin-left: 16px
        height: 16px;
        font-size: 14px;
        font-weight: 500;
        color: #282828;
        line-height: 16px;
    }

    .content {
        margin-top: 12px
        margin-left: 16px
        height: 14px;
        font-size: 14px;
        font-weight: 400
        color: #282828;
        line-height: 16px

        > span {
            vertical-align: top
            margin-left: 4px
        }

        > input {
            width: 14px
            height: 14px
        }
    }
}

// Toolpath / Simulation segmented control at the top centre of the canvas (steps 2/3, CNC)
.preview-segmented {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    display: flex;
    gap: 2px;
    padding: 4px;
    background: #ffffff;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(20, 30, 50, .08);
}

.segment {
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #5b6170;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;

    &:hover {
        background: #eef1f6;
        color: #1f2430;
    }

    &:focus-visible {
        outline: 2px solid #1d4ed8;
        outline-offset: 1px;
    }

    &.active {
        background: #e8eefc;
        color: #1d4ed8;
    }
}
