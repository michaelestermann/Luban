// Properties panel of the Laser/CNC editor (redesign mockup "InteractionA" + "Position V2")
.props {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0 4px;
}

.grid2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

.field {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #ffffff;
    font-size: 13px;
    color: #1f2430;
    min-width: 0;

    &:focus-within {
        border-color: #1d4ed8;
    }

    &.disabled {
        border-color: #e3e6ec;
        background: #f0f2f5;
        color: #b8bfcc;

        .prefix,
        :global(.ant-input),
        :global(.ant-input-suffix) {
            color: #b8bfcc !important;
        }
    }

    // the NumberInput fills the field; the border belongs to the field
    > span:last-child {
        flex: 1 1 auto;
        min-width: 0;
    }

    :global(.ant-input-affix-wrapper),
    :global(.ant-input) {
        width: 100% !important;
        height: 30px;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        font-size: 13px;
        color: inherit;
    }

    :global(.ant-input-suffix) {
        font-size: 12px;
        color: #5b6170;
    }
}

.prefix {
    flex: 0 0 auto;
    color: #5b6170;
}

.buttons {
    display: flex;
    gap: 6px;
}

.icon-button {
    width: 36px;
    height: 34px;
    padding: 0;
    border: 1px solid #d9dde6;
    border-radius: 6px;
    background: #ffffff;
    color: #2f3441;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &.on {
        border-color: #1d4ed8;
        background: #e8eefc;
        color: #1d4ed8;
    }

    &:disabled {
        cursor: not-allowed;
        border-color: #e3e6ec;
        background: #f0f2f5;
        color: #b8bfcc;
    }
}

// processing mode tiles (image cards)
.modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 8px 0;
}

.mode {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px;
    border: 2px solid #e3e6ec;
    border-radius: 10px;
    background: #ffffff;
    color: #2f3441;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    min-width: 0;

    &.on {
        border-color: #1d4ed8;
        background: #e8eefc;
        color: #1d4ed8;
    }

    &:disabled {
        cursor: not-allowed;
        opacity: .5;
    }

    img,
    svg {
        width: 100%;
        max-width: 112px;
        height: 64px;
        border-radius: 6px;
        object-fit: cover;
    }

    span {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
}

// laser: four modes in one row, existing pictures as background images
.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;

    .mode {
        padding: 6px 4px;
        font-size: 11px;
    }

    .mode i {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        margin: 0;
        border-radius: 6px;
        background-size: cover;
        background-position: center;
    }
}

.mode i {
    display: block;
    width: 100%;
    height: 64px;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
}

// read-only geometry of the selection (under Position & size)
.geometry {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    padding: 7px 10px;
    border-radius: 6px;
    background: #f4f6f9;
    font-size: 12px;
    color: #1f2430;
}

.geometry-title {
    flex: 0 0 100%;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #5b6170;
}

.geometry-item {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    white-space: nowrap;

    b {
        font-weight: 600;
    }
}

.unit {
    color: #5b6170;
}

// Offset values (key O / "⋯" → Offset) above Position & size
.offset {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0 12px;
    padding: 12px;
    border: 1px solid #c9d6f5;
    border-radius: 10px;
    background: #f7f9fe;
}

.offset-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    color: #1d4ed8;
}

.offset-count {
    font-size: 12px;
    font-weight: 400;
    color: #5b6170;
}

.offset-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
}

.offset-field {
    flex: 1 1 auto;
}

.offset-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 13px;
    color: inherit;
}

.segmented {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    padding: 2px;
    border-radius: 8px;
    background: #e9edf4;
}

.segmented-item {
    height: 30px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #2f3441;
    font-size: 12px;
    cursor: pointer;

    &.on {
        background: #ffffff;
        color: #1d4ed8;
        font-weight: 600;
        box-shadow: 0 1px 3px rgba(20, 30, 50, .12);
    }
}

.offset-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #2f3441;
    cursor: pointer;
}

.offset-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.offset-cancel,
.offset-create {
    height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    font-size: 13px;
    cursor: pointer;
}

.offset-cancel {
    border: 1px solid #d9dde6;
    background: #ffffff;
    color: #2f3441;
}

.offset-create {
    border: 0;
    background: #1d4ed8;
    color: #ffffff;
    font-weight: 600;

    &:disabled {
        background: #c4c8d1;
        cursor: not-allowed;
    }
}

// corner radius of a rectangle (under Rotate)
.corners {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.corners-unlocked {
    display: flex;
    align-items: flex-start;
    gap: 8px;

    > .grid2 {
        flex: 1 1 auto;
    }
}

.corners-hint {
    font-size: 12px;
    color: #b45309;
}
