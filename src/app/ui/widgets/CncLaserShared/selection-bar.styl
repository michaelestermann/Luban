// Floating selection bar at the top centre of the canvas (redesign mockup InteractionA)
.selection-bar {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    display: flex;
    align-items: center;
    gap: 2px;
    max-width: calc(100% - 32px);
    padding: 4px;
    background: #ffffff;
    border: 1px solid #e3e6ec;
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(20, 30, 50, .08);
}

.label {
    padding: 0 8px;
    max-width: 180px;
    font-size: 12px;
    color: #5b6170;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tip-wrapper {
    display: inline-flex;
}

.icon-button {
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2f3441;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &:disabled {
        color: #c4c8d1;
        cursor: not-allowed;
        pointer-events: none;
    }
}

.text-button {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: #e8eefc;
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #dbe4fb;
    }

    &:disabled {
        background: transparent;
        color: #9aa1b0;
        cursor: not-allowed;
    }
}

.align-menu {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 4px;
}

// Combine ▾ and ⋯ menus: action and its key
.action-menu {
    display: flex;
    flex-direction: column;
    min-width: 180px;
    margin: -4px -8px;
}

.menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 32px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #2f3441;
    font-size: 13px;
    text-align: left;
    cursor: pointer;

    &:hover {
        background: #eef1f6;
    }
}

.menu-key {
    color: #9aa1b0;
    font-size: 12px;
}

// "Set origin here" with its point picker at the end of the "⋯" menu
.origin-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid #eceef2;
}

.origin-title {
    align-self: stretch;
    padding: 0 10px;
    color: #5b6170;
    font-size: 12px;
}

// mode bar of the point editing mode
.mode-title {
    padding: 0 4px 0 8px;
    font-size: 13px;
    font-weight: 700;
    color: #1d4ed8;
    white-space: nowrap;
}

.mode-button {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #2f3441;
    font-size: 13px;
    white-space: nowrap;
    cursor: pointer;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &.on {
        background: #e8eefc;
        color: #1d4ed8;
        font-weight: 600;
    }

    &:disabled {
        color: #c4c8d1;
        cursor: not-allowed;
        pointer-events: none;
    }
}

.done-button {
    height: 36px;
    margin-left: 4px;
    padding: 0 14px;
    border: 0;
    border-radius: 8px;
    background: #1d4ed8;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;

    &:hover {
        background: #1e40af;
    }
}

// selected path with open ends
.open-label {
    padding: 2px 8px;
    border-radius: 6px;
    background: #fff4e5;
    color: #c2410c;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}
