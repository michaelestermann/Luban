

.progressbar {

    .progress-notice {
        position: relative;
        top: 0;
    }
    :global(.ant-progress) {
        top: 6px;
        color: #D5D6D9;
        :global(.ant-progress-inner) {
            top: -8px;
            height: 12px;
            :global(.ant-progress-bg) {
                height 12px !important;
            }
        }
        :global(.ant-progress-outer) {
            margin-right: 0!important;
            padding-right: 0!important;
        }
        :global(.ant-progress-status-success) :global(.ant-progress-bg){
            background-color: #1890ff!important;
        }
    }
    :global(.ant-progress-text) {
        display: none;
    }
}

.stalled {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 4px 0 28px;
    color: #545659;
}

.stop-button {
    height: 28px;
    margin-left: 12px;
    padding: 0 16px;
    border: 1px solid #c4c6c9;
    border-radius: 4px;
    background: #fff;
    color: #2a2c2e;
    cursor: pointer;
    &:hover {
        border-color: #1890ff;
        color: #1890ff;
    }
}
