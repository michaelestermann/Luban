// Stepper and primary action of the Laser/CNC editor (colours from the redesign mockups)
.stepper {
    display: flex;
    align-items: center;
    gap: 4px;
}

.step {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: #2f3441;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;

    &:hover:not(:disabled):not(.current) {
        background: #eef1f6;
    }

    &.done {
        color: #15803d;
        font-weight: 600;
    }

    &.current {
        background: #1d4ed8;
        color: #ffffff;
        font-weight: 600;
        cursor: default;
    }

    &:disabled {
        color: #b4b9c4;
        cursor: not-allowed;
    }
}

// the check of a done step: always takes its space, shown when the step is done
.check-slot {
    display: inline-flex;
    visibility: hidden;

    &.shown {
        visibility: visible;
    }
}

// reserves the width of the bold text, so a step does not grow when it becomes current or done
.step-label {
    display: inline-flex;
    flex-direction: column;

    &::after {
        content: attr(data-label);
        height: 0;
        overflow: hidden;
        visibility: hidden;
        font-weight: 600;
    }
}

.actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

// all states of the action group share one grid cell: the slot is as wide as the widest state,
// so the steps left of it never move when the step changes
.actions-slot {
    display: grid;
}

.actions-slot > .actions {
    grid-row: 1;
    grid-column: 1;
    justify-content: flex-end;
}

.sizer {
    visibility: hidden;
    pointer-events: none;

    .secondary,
    .primary {
        display: inline-flex;
        align-items: center;
    }
}

.secondary,
.primary {
    height: 36px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;

    &:disabled {
        cursor: not-allowed;
    }
}

.secondary {
    padding: 0 16px;
    border: 1px solid #d9dde6;
    background: #ffffff;
    color: #1f2430;

    &:hover:not(:disabled) {
        background: #eef1f6;
    }

    &:disabled {
        color: #b4b9c4;
    }
}

.primary {
    padding: 0 18px;
    border: 0;
    background: #1d4ed8;
    color: #ffffff;

    &:hover:not(:disabled) {
        background: #1e40af;
    }

    &:disabled {
        background: #e8eefc;
        color: #9aa1b0;
    }
}
